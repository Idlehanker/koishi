{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "sourceMap": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "strictBindCallApply": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@satorijs/element",
    "types": [
      "yml-register/types",
    ],
    "baseUrl": ".",
    "paths": {
      "@koishijs/plugin-database-*": ["plugins/database/*/src"],
      "@koishijs/plugin-*": ["plugins/common/*/src", "plugins/*/src"],
      "@koishijs/*": ["packages/*/src"],
      "koishi": ["packages/koishi/src"],
    },
  },
}
