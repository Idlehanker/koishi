{
  "extends": "./tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@koishijs/plugin-database-*": [
        "plugins/database/*/src",
      ],
      "@koishijs/plugin-*": [
        "plugins/common/*/src",
        "plugins/*/src",
      ],
      "@koishijs/*": [
        "packages/*/src",
      ],
      "cosmokit": [
        "external/cosmokit/src",
      ],
      "cosmokit/*": [
        "external/cosmokit/src/*",
      ],
      "satori": [
        "external/satori/packages/core/src",
      ],
      "@satorijs/*": [
        "external/satori/packages/*/src",
        "external/satori/adapters/*/src",
      ],
      "minato": [
        "external/minato/packages/core/src",
      ],
      "@minatojs/driver-*": [
        "external/minato/packages/*/src",
      ],
      "cordis": [
        "external/cordis/packages/cordis/src",
      ],
      "@cordisjs/plugin-*": [
        "external/cordis/packages/*/src",
      ],
      "@cordisjs/*": [
        "external/cordis/packages/*/src",
      ],
      "*": [
        "packages/*/src",
      ],
    },
  },
  "files": [],
}
